{
  "name": "@ai-dashboard/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --port 3000",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "build": "pnpm --filter @ai-dashboard/contracts build && pnpm --filter @ai-dashboard/datasource-contract build && pnpm --filter @ai-dashboard/component-catalog build && rsbuild build",
    "preview": "rsbuild preview --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-dashboard/component-catalog": "workspace:*",
    "@ai-dashboard/contracts": "workspace:*",
    "@ai-dashboard/datasource-contract": "workspace:*",
    "@ant-design/icons": "^5.6.1",
    "@json-render/core": "0.23.2",
    "@json-render/react": "0.23.2",
    "@tanstack/react-query": "^5.74.3",
    "antd": "^5.24.7",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.3.13",
    "@rsbuild/plugin-react": "^1.2.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6"
  }
}
